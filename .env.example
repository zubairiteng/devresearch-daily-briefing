# ==============================================================================
# DevResearch Daily Briefing - Environment Configuration
# ==============================================================================

# Application Environment & Timezone
APP_ENV=production
DEBUG=false
TIMEZONE=Asia/Karachi
DIGEST_TIME="10:00"
DATABASE_URL=sqlite:///./devresearch.db

# LLM Summarizer Configuration
# Options: "gemini", "openai", "anthropic", or "heuristic" (local fallback if no API key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Email Delivery Configuration
# Options: "smtp", "resend", "sendgrid", or "console" (prints to logs / dev mode)
MAIL_PROVIDER=console
MAIL_FROM="DevResearch Daily <daily@devresearch.local>"
MAIL_RECIPIENTS="user@example.com"

# SMTP Settings (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true

# Resend / SendGrid Settings (Optional alternatives to SMTP)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional News / Search APIs
TAVILY_API_KEY=
NEWSAPI_API_KEY=

# IMAP Email Alert Parser (Optional - for parsing Rozee / Indeed / LinkedIn job alert emails)
IMAP_ENABLED=false
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_FOLDER=INBOX

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
